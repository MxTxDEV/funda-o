# =====================================================================
# Virtual Company — FOUNDATION v1.0 — environment variables
# Copy to .env (local) or configure in Vercel / worker host. Never commit real secrets.
# =====================================================================

# --- Database (PostgreSQL 16+) ---
# Runtime URL. On Vercel use the POOLED connection string (e.g. Neon "-pooler" host).
DATABASE_URL=postgres://vc:vc_dev_password@localhost:5432/virtual_company
# Direct (non-pooled) URL used only by migrations. Optional locally.
DATABASE_URL_UNPOOLED=
# Connections per process. Use 1-3 on serverless (Vercel), 10 for the worker.
DB_POOL_MAX=10
# Set to "false" when using a transaction pooler (PgBouncer / Neon pooled / Supabase 6543).
DB_PREPARE=true

# --- Redis (BullMQ queue + rate limiting) ---
# Must be a TCP Redis (redis:// or rediss://). Upstash REST URLs do NOT work with BullMQ.
REDIS_URL=redis://localhost:6379
# Key prefix for queues (isolate environments sharing one Redis: vc-prod, vc-staging...)
QUEUE_PREFIX=vc

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
# Public URL of the web app (required outside Vercel). Vercel sets it automatically.
AUTH_URL=http://localhost:3000
# Trust the Host header (needed behind proxies / Docker). Vercel sets it automatically.
AUTH_TRUST_HOST=true

# --- Bootstrap admin (used only by `pnpm db:seed:admin`) ---
ADMIN_EMAIL=admin@example.com
# Min 12 chars, 3 of: lowercase, uppercase, digits, symbols.
ADMIN_PASSWORD=
ADMIN_NAME=Proprietário

# --- Worker ---
WORKER_CONCURRENCY=5
# Optional HTTP liveness port for container platforms (GET / → {"ok":true})
WORKER_HEALTH_PORT=
# Duration of each simulated step of the DEMO processor (ms)
DEMO_PROCESSOR_STEP_MS=1500

# --- Demo data ---
# The demo seed refuses to run with NODE_ENV=production unless this is "true".
ALLOW_DEMO_SEED=false

# --- Misc ---
LOG_LEVEL=info

# --- Tests (optional) ---
TEST_DATABASE_URL=postgres://vc:vc_dev_password@localhost:5432/virtual_company_test
TEST_REDIS_URL=redis://localhost:6379/1
