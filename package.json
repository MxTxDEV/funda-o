{
  "name": "virtual-company",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @vc/web test:e2e",
    "db:generate": "pnpm --filter @vc/db db:generate",
    "db:migrate": "pnpm --filter @vc/db db:migrate",
    "db:seed:admin": "pnpm --filter @vc/core db:seed:admin",
    "db:seed:demo": "pnpm --filter @vc/core db:seed:demo",
    "db:demo:purge": "pnpm --filter @vc/core db:demo:purge",
    "db:seed:team": "pnpm --filter @vc/core db:seed:team"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
